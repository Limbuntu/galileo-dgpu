# 构建产物(在 docker 卷 gres-out,不在本树)
/dl/
/output/
*.o
*.lo
*.la
.DS_Store
__pycache__/
# 黄金文件里的运行时产物
board/intel/galileo/rootfs_overlay_v3/root/doom/.savegame/
images/

# Game data is never committed (multi-GB, third-party media): it is staged into
# this directory on the build host and reaches the CI runner through the
# galileo-games volume (tools/push-dosgames.sh).
board/intel/galileo/rootfs_overlay_dosbox/usr/share/dosgames/
board/intel/galileo/dosgames-assets/
tmp/games/
# runtime log written by the board
board/intel/galileo/rootfs_overlay_desktop/root/doom/doom.log
# screen recordings / demo clips live outside the tree
assets/

# operator-side export filters (kept out of the repo: they name the content
# the export removes)
tools/export-extra-filters.local
