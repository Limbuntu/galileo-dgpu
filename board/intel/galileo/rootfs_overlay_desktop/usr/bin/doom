#!/bin/sh
# doom: run Doom on KMS/DRM instead of through X.
#
# The X11 (xlib) backend pushed the whole 1280x1024 window through the X socket
# every frame - 5.24 MB at the ~10.5 MB/s this CPU sustains, i.e. 2 fps, and
# the picture repainted top-to-bottom while the display scanned it out.
#
# doomgeneric-kms renders 320x200 (256 KB/frame) into a dumb buffer and lets
# the display controller's plane scaler stretch it to 1280x800, with vblank
# page flips: ~28 fps, no tearing, no CPU cost for the upscale.
#
# DRM master is exclusive, so the desktop is stopped for the duration and
# brought back afterwards (S50desktop restarts X + the whole LXDE session).
S50=/etc/init.d/S50desktop
cd /root/doom || exit 1
$S50 stop >/dev/null 2>&1
killall Xorg openbox lxpanel pcmanfm xterm 2>/dev/null
sleep 2
rm -f /tmp/.X0-lock /tmp/.X11-unix/X0
./doomgeneric-kms -iwad freedoom1.wad "$@"
$S50 start >/dev/null 2>&1
