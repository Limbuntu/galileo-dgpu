#!/bin/sh
# S50desktop: GPU drivers + X desktop on the Galileo.
#
# Xorg is started DIRECTLY (not via xinit): xinit's client/session handling
# proved fragile here, and buildroot's own S40xorg (removed in post-build)
# used to grab display 0 on vt01 and fight the respawning tty1 getty,
# cycling the display signal. We run on vt7 to stay clear of the getty.
#
# Proven working: Galileo Gen 2 + HD 6450 (Caicos, radeon) at 1280x1024.

SWAPFILE=/swapfile

start_x() {
	rm -f /tmp/.X0-lock /tmp/.X11-unix/X0
	/usr/bin/Xorg :0 vt7 -nolisten tcp -config /etc/X11/xorg.conf \
		>/var/log/X.log 2>&1 &
	sleep 8
	if ! ps | grep -v grep | grep Xorg >/dev/null 2>&1; then
		echo "S50desktop: Xorg failed to start, see /var/log/X.log"
		return 1
	fi
	# retry session until X is actually accepting connections (cold boot is slow)
	(
		n=0
		while [ $n -lt 15 ]; do
			DISPLAY=:0 /usr/bin/openbox >/var/log/openbox.log 2>&1
			sleep 2
			DISPLAY=:0 xterm -geometry 100x30+8+8 -title console \
				>/var/log/xterm.log 2>&1
			sleep 1
			ps | grep -v grep | grep openbox >/dev/null 2>&1 && break
			n=$((n+1))
		done
	) &
	echo "S50desktop: desktop up on /dev/dri/card0"
}

case "$1" in
	start)
		# First boot: create a 256 MB swapfile on the SD card.
		if [ ! -f "$SWAPFILE" ]; then
			echo "S50desktop: creating $SWAPFILE (256M)..."
			dd if=/dev/zero of="$SWAPFILE" bs=1M count=256 2>/dev/null
			mkswap "$SWAPFILE" >/dev/null 2>&1
		fi
		swapon "$SWAPFILE" 2>/dev/null
		# radeon binds HD 6450 (Caicos), amdgpu binds RX 580 (Polaris).
		modprobe amdgpu 2>/dev/null
		modprobe radeon 2>/dev/null
		sleep 3
		if [ -e /dev/dri/card0 ]; then
			start_x
		else
			echo "S50desktop: WARNING: /dev/dri/card0 missing, console only."
		fi
		;;
	stop)
		killall Xorg openbox xterm 2>/dev/null
		;;
	restart|reload)
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
esac
