#!/bin/sh
# media-console - on-screen media browser (players run in the background so
# the menu keeps accepting keys while something plays)
MEDIA=/root/media
export MPG123_MODDIR=/usr/lib/mpg123
A1="$MEDIA/track-a.mp3"
A2="$MEDIA/track-b.mp3"
V1="$MEDIA/bbb_vcd.mpg"
V2="$MEDIA/bbb_light.mpg"
V3="$MEDIA/bbb_hw.mp4"

meta() {
	# no ffprobe in the image: parse "Duration: HH:MM:SS.xx" from ffmpeg
	ffmpeg -hide_banner -i "$1" 2>&1 | awk -F'[:,.]' '/Duration/ {print ($2*3600)+($3*60)+$4; exit}'
}
fmt() { s=${1:-0}; printf '%d:%02d' $((s/60)) $((s%60)); }
stop_all() { killall mpg123 2>/dev/null; killall ffplay 2>/dev/null; }
play_audio() { stop_all; setsid mpg123 -q "$1" >/dev/null 2>&1 & NOW="audio: $(basename "$1")"; }
play_video() { stop_all; setsid ffplay -autoexit -x 640 -y 480 -window_title "Big Buck Bunny" "$1" >/dev/null 2>&1 & NOW="video: $(basename "$1") (windowed)"; }

NOW="nothing"
while :; do
	clear
	printf '\033[1;36m'
	printf '  +----------------------------------------------------------+\n'
	printf '  |            Galileo Gen 2  -  Media Console               |\n'
	printf '  +----------------------------------------------------------+\n'
	printf '\033[0m'
	printf '  AUDIO   (mpg123)\n'
	printf '    \033[1;33m1)\033[0m the artist - Blue Turkey          \033[2m%s\033[0m\n' "$(fmt "$(meta "$A1")")"
	printf '    \033[1;33m2)\033[0m the artist - Remember Me         \033[2m%s\033[0m\n' "$(fmt "$(meta "$A2")")"
	printf '\n  VIDEO   (ffplay, 640x480 window)\n'
	printf '    \033[1;33m3)\033[0m Big Buck Bunny  VCD 352x288          \033[2m%s\033[0m\n' "$(fmt "$(meta "$V1")")"
	printf '    \033[1;33m4)\033[0m Big Buck Bunny  light 256x192          \033[2m%s\033[0m\n' "$(fmt "$(meta "$V2")")"
	printf '    \033[1;33m5)\033[0m Big Buck Bunny  H.264 + GPU decode      \033[2m%s\033[0m\n' "$(fmt "$(meta "$V3")")"
	printf '    \033[1;33m6)\033[0m Big Buck Bunny  KMS direct (no X)       \033[2m%s\033[0m\n' "$(fmt "$(meta "$V3")")"
	printf '    \033[1;33m7)\033[0m Pre-baked frames  flip mode (~9%% CPU)  \033[2m%s\033[0m\n' "8s loop"
	printf '    \033[1;33m8)\033[0m Stream 1 min into VRAM (TCP 9000)      \033[2m%s\033[0m\n' "wait for sender"
	printf '    \033[1;33m9)\033[0m Big Buck Bunny  1080p60 UVD zero-copy  \033[2m%s\033[0m\n' "10:34"
	printf '    \033[1;33m10)\033[0m Big Buck Bunny 4K30 (30s, UVD)          \033[2m%s\033[0m\n' "0:30"
	printf '\n  \033[1;36m----------------------------------------------------------\033[0m\n'
	printf '  now: %s\n' "$NOW"
	printf '  s) stop   a) audio out   r) redraw   q) quit\n'
	printf '\n  Select: '
	read -r k
	case "$k" in
	1) play_audio "$A1" ;;
	2) play_audio "$A2" ;;
	3) play_video "$V1" ;;
	4) stop_all; setsid ffplay -autoexit -x 512 -y 384 -window_title "Big Buck Bunny (light)" "$V2" >/dev/null 2>&1 & NOW="video: bbb_light.mpg (256x192)" ;;
	5) stop_all; setsid env DISPLAY=:0 VDPAU_DRIVER=radeonsi mpv --no-config --really-quiet --hwdec=vdpau --vo=vdpau --geometry=640x360 "$V3" >/dev/null 2>&1 & NOW="video: bbb_hw.mp4 (H.264, vdpau)" ;;
	6) stop_all; setsid /usr/bin/kms-player "$V3" >/dev/null 2>&1 & NOW="KMS direct mode (Enter/Space returns to desktop)" ;;
	7) stop_all; setsid /usr/bin/flip-demo >/dev/null 2>&1 & NOW="flip mode: frames already in VRAM" ;;
	8) stop_all; setsid /usr/bin/stream-demo 9000 >/dev/null 2>&1 & NOW="streaming: waiting on tcp/9000 (any key returns)" ;;
	9) stop_all; setsid /usr/bin/minplayer-demo >/dev/null 2>&1 & NOW="1080p60 UVD zero-copy (any key returns)" ;;
	10) stop_all; setsid /usr/bin/minplayer-demo /root/media/bbb_4k30_30s.mp4 >/dev/null 2>&1 & NOW="4K30 UVD zero-copy (any key returns)" ;;
	s) stop_all; NOW="stopped" ;;
	a) audio-out usb >/dev/null 2>&1; NOW="audio out -> usb" ;;
	r) : ;;
	q) stop_all; break ;;
	esac
done
