#!/bin/sh
# media-console - on-screen media browser (players run in the background so
# the menu keeps accepting keys while something plays).
#
# Files are expected under /root/media (they are not in the image: the clips
# are multi-MB media, staged on the board the same way the game data is).
# The 4K entry is the point of the whole exercise: UVD decode -> dmabuf -> EGL
# -> GBM -> page flip, i.e. minplayer with no copy through X.
MEDIA=/root/media
V1="$MEDIA/bbb_vcd.mpg"
V2="$MEDIA/bbb_light.mpg"
V3="$MEDIA/bbb_hw.mp4"
V4="$MEDIA/bbb_4k30_30s.mp4"
BA="$MEDIA/Bad Apple 4K30 H264 + adaptive framecounter v4.mp4"

meta() {
	# no ffprobe in the image: parse "Duration: HH:MM:SS.xx" from ffmpeg
	ffmpeg -hide_banner -i "$1" 2>&1 | awk -F'[:,.]' '/Duration/ {print ($2*3600)+($3*60)+$4; exit}'
}
fmt() { s=${1:-0}; printf '%d:%02d' $((s/60)) $((s%60)); }
stop_all() { killall ffplay mpv minplayer 2>/dev/null; }
play_video() { stop_all; setsid ffplay -autoexit -x 640 -y 480 -window_title "Big Buck Bunny" "$1" >/dev/null 2>&1 & NOW="video: $(basename "$1") (windowed)"; }

NOW="nothing"
while :; do
	clear
	printf '\033[1;36m'
	printf '  +----------------------------------------------------------+\n'
	printf '  |            Galileo Gen 2  -  Media Console               |\n'
	printf '  +----------------------------------------------------------+\n'
	printf '\033[0m'
	printf '  VIDEO   (ffplay / mpv / minplayer)\n'
	printf '    \033[1;33m1)\033[0m Big Buck Bunny  VCD 352x288          \033[2m%s\033[0m\n' "$(fmt "$(meta "$V1")")"
	printf '    \033[1;33m2)\033[0m Big Buck Bunny  light 256x192        \033[2m%s\033[0m\n' "$(fmt "$(meta "$V2")")"
	printf '    \033[1;33m3)\033[0m Big Buck Bunny  H.264 + GPU decode    \033[2m%s\033[0m\n' "$(fmt "$(meta "$V3")")"
	printf '    \033[1;33m4)\033[0m Big Buck Bunny  KMS direct (no X)     \033[2m%s\033[0m\n' "$(fmt "$(meta "$V3")")"
	printf '    \033[1;33m5)\033[0m Pre-baked frames  flip mode (~9%% CPU)\033[2m%s\033[0m\n' "8s loop"
	printf '    \033[1;33m6)\033[0m H.264 640x360  UVD zero-copy (live) \033[2m%s\033[0m\n' "10:34"
	printf '    \033[1;33m7)\033[0m Big Buck Bunny 4K30 (30s, UVD)        \033[2m%s\033[0m\n' "0:30"
	printf '    \033[1;33m8)\033[0m Bad Apple 4K60 HEVC (UVD, 4 min)     \033[2m%s\033[0m\n' "$(fmt "$(meta "$BA")")"
	printf '\n  \033[1;36m----------------------------------------------------------\033[0m\n'
	printf '  now: %s\n' "$NOW"
	printf '  s) stop   r) redraw   q) quit\n'
	printf '\n  Select: '
	read -r k
	case "$k" in
	1) play_video "$V1" ;;
	2) stop_all; setsid ffplay -autoexit -x 512 -y 384 -window_title "Big Buck Bunny (light)" "$V2" >/dev/null 2>&1 & NOW="video: bbb_light.mpg (256x192)" ;;
	3) stop_all; setsid env DISPLAY=:0 VDPAU_DRIVER=radeonsi mpv --no-config --really-quiet --hwdec=vdpau --vo=vdpau --geometry=640x360 "$V3" >/dev/null 2>&1 & NOW="video: bbb_hw.mp4 (H.264, vdpau)" ;;
	4) stop_all; setsid /usr/bin/kms-player "$V3" >/dev/null 2>&1 & NOW="KMS direct mode (Enter/Space returns to desktop)" ;;
	5) stop_all; setsid /usr/bin/flip-demo >/dev/null 2>&1 & NOW="flip mode: frames already in VRAM" ;;
	6) stop_all; setsid /usr/bin/minplayer-demo "$V3" 640 >/dev/null 2>&1 & NOW="H.264 640x360 UVD zero-copy (any key returns)" ;;
	7) stop_all; setsid /usr/bin/minplayer-demo "$V4" 30 >/dev/null 2>&1 & NOW="4K30 UVD zero-copy (any key returns)" ;;
	8) stop_all; setsid /usr/bin/minplayer-demo "$BA" 240 >/dev/null 2>&1 & NOW="Bad Apple 4K60 HEVC (any key returns)" ;;
	s) stop_all; NOW="stopped" ;;
	r) : ;;
	q) stop_all; break ;;
	esac
done
