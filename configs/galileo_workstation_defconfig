# Galileo Gen 2 V4 "gnu" — glibc + OpenJDK 实验(Java/Minecraft 探索)
# Base: dmarkey/galileo-resurrection galileo_defconfig (known-booting 5.10.29)
# Changes: amdgpu (non-DC legacy DCE11 path) + radeon (atom path), Xorg +
#          openbox + xterm desktop, polaris10 + CAICOS/radeon firmware,
#          dropbear SSH, swapfile on first boot.
BR2_x86_x1000=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_INSTALL_LIBSTDCPP=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_MDEV=y
BR2_TARGET_GENERIC_GETTY_PORT="ttyS1"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
BR2_TARGET_GENERIC_ROOT_PASSWD="galileo"
BR2_ROOTFS_OVERLAY="board/intel/galileo/rootfs_overlay_common board/intel/galileo/rootfs_overlay_desktop board/intel/galileo/rootfs_overlay_workstation"
BR2_ROOTFS_POST_BUILD_SCRIPT="board/intel/galileo/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="board/intel/galileo/post-image.sh"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="5.10.29"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="board/intel/galileo/linux-rx580.config"
BR2_LINUX_KERNEL_INSTALL_TARGET=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="3000M"
BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_I386_EFI=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y

# RX 580 + HD 6450 firmware (amdgpu trimmed to polaris10* in post-build)
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_AMDGPU=y
BR2_PACKAGE_LINUX_FIRMWARE_RADEON=y

# X.org desktop (no GL/mesa: modesetting + shadowfb software 2D)
BR2_PACKAGE_XORG7=y
BR2_PACKAGE_XSERVER_XORG_SERVER=y
BR2_PACKAGE_XSERVER_XORG_SERVER_MODULAR=y
BR2_PACKAGE_XDRIVER_XF86_INPUT_EVDEV=y
BR2_PACKAGE_XDRIVER_XF86_VIDEO_ATI=y
BR2_PACKAGE_XDRIVER_XF86_INPUT_KEYBOARD=y
BR2_PACKAGE_XDRIVER_XF86_INPUT_MOUSE=y
BR2_PACKAGE_XAPP_XINIT=y
BR2_PACKAGE_XTERM=y
BR2_PACKAGE_OPENBOX=y

# Remote access for debugging
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_BASH=y
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# Minetest (Luanti) with software GL
# radeonsi needs libdrm_amdgpu at configure time; without it Mesa fails with
# 'Dependency "libdrm_amdgpu" not found' and the image ships swrast only.
BR2_PACKAGE_LIBDRM=y
BR2_PACKAGE_LIBDRM_AMDGPU=y
BR2_PACKAGE_LIBDRM_RADEON=y
BR2_PACKAGE_LIBDRM_NOUVEAU=y

BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_DRI_DRIVER_SWRAST=y
BR2_PACKAGE_MESA3D_OPENGL_GLX=y
BR2_PACKAGE_MINETEST=y

# Browser + OpenTTD SDL
BR2_PACKAGE_LINKS=y
BR2_PACKAGE_LINKS_GRAPHICS=y
BR2_PACKAGE_SDL=y
BR2_PACKAGE_MINETEST_GAME=y

# LXDE desktop stack
BR2_PACKAGE_LIBGTK2=y
BR2_PACKAGE_LIBFM=y
BR2_PACKAGE_MENU_CACHE=y
BR2_PACKAGE_PCMANFM=y
BR2_PACKAGE_GTK2_ENGINES=y
BR2_PACKAGE_CAIRO_PDF=y
BR2_PACKAGE_PCIUTILS=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_R600=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_LIBEPOXY=y
BR2_PACKAGE_LIBOPENSSL=y
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_NETSURF=y
BR2_PACKAGE_NETSURF_GTK=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_OPENJDK=y
BR2_CCACHE=y
BR2_CCACHE=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_RADEONSI=y
BR2_PACKAGE_MESA3D_LLVM=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_NOUVEAU=y
BR2_PACKAGE_XAPP_XRANDR=y
BR2_PACKAGE_XDRIVER_XF86_VIDEO_MODESETTING=y
BR2_PACKAGE_P7ZIP=y

# --- GPU/CPU benchmark tools ---
BR2_PACKAGE_GLMARK2=y
BR2_PACKAGE_MESA3D_DEMOS=y
BR2_PACKAGE_GTKPERF=y
BR2_PACKAGE_OPENARENA=y
