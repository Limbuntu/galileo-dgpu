# Galileo Gen 2 - desktop image
# X + openbox + xterm + pcmanfm + the GPU media stack: the same UVD/VA-API
# 4K playback path the workstation image has (libva + minplayer, mpv/VDPAU,
# ffplay), so a desktop card can show video without the extra workstation
# apps. Falls back to swrast on a card without UVD.
BR2_x86_x1000=y
BR2_TOOLCHAIN_BUILDROOT_WCHAR=y
# pcmanfm -> libgtk2 -> pango -> harfbuzz needs a C++ runtime
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_INSTALL_LIBSTDCPP=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_MDEV=y
BR2_TARGET_GENERIC_GETTY_PORT="ttyS1"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
BR2_TARGET_GENERIC_ROOT_PASSWD="galileo"
BR2_ROOTFS_OVERLAY="board/intel/galileo/rootfs_overlay_common board/intel/galileo/rootfs_overlay_desktop"
BR2_ROOTFS_POST_BUILD_SCRIPT="board/intel/galileo/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="board/intel/galileo/post-image.sh"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="5.10.29"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="board/intel/galileo/linux-rx580.config"
BR2_LINUX_KERNEL_INSTALL_TARGET=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="3000M"
BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_I386_EFI=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y

# HD 6450 (Caicos) 显示输出所需固件(radeon KMS)
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_RADEON=y

# X.org + xterm 终端(modesetting; GPU 加速由下面的 media 栈提供)
BR2_PACKAGE_XORG7=y
BR2_PACKAGE_XSERVER_XORG_SERVER=y
BR2_PACKAGE_XSERVER_XORG_SERVER_MODULAR=y
BR2_PACKAGE_XDRIVER_XF86_INPUT_EVDEV=y
BR2_PACKAGE_XDRIVER_XF86_INPUT_KEYBOARD=y
BR2_PACKAGE_XDRIVER_XF86_INPUT_MOUSE=y
BR2_PACKAGE_XAPP_XINIT=y
BR2_PACKAGE_XTERM=y
BR2_PACKAGE_OPENBOX=y

# 文件管理器
BR2_PACKAGE_PCMANFM=y

# 基础系统
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_BASH=y
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_CCACHE=y

# --- GPU media stack: the A-card 4K path, identical to the workstation image ---
# minplayer (VA-API -> dmabuf -> EGL -> GBM -> page flip) needs libva, EGL/GLES
# from Mesa and the DRM/amdgpu node; mpv presents VDPAU frames for the windowed
# path, ffplay for the software-decoded 352x288/256x192 clips.
BR2_PACKAGE_LIBDRM=y
BR2_PACKAGE_LIBDRM_AMDGPU=y
BR2_PACKAGE_LIBDRM_RADEON=y
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_DRI_DRIVER_SWRAST=y
BR2_PACKAGE_MESA3D_OPENGL_GLX=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_R600=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_RADEONSI=y
BR2_PACKAGE_MESA3D_LLVM=y
BR2_PACKAGE_LIBVA=y
# VDPAU state tracker: hardware decode through radeonsi/UVD, X11 only
BR2_PACKAGE_MESA3D_VDPAU=y
BR2_PACKAGE_LIBVDPAU=y
BR2_PACKAGE_MPV=y
BR2_PACKAGE_FFMPEG=y
BR2_PACKAGE_FFMPEG_FFPLAY=y
BR2_PACKAGE_SDL2_X11=y

# audio out (aplay/amixer) for the media console and the panel applet
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
